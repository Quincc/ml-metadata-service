{% extends "base.html.j2" %}
{% import "components/displays.html.j2" as displays %}
{% import "components/forms.html.j2" as forms %}

{% block title %}{{ model.name }} · Metadata Atlas{% endblock title %}

{% block body %}
  <div class="page-shell">
    <div class="ambient ambient-left"></div>
    <div class="ambient ambient-right"></div>

    <header class="hero">
      <div class="hero-main">
        <p class="eyebrow">
          <a class="ghost-link" href="/ui">← Dashboard</a>
          {% if model.deleted_at %}
            <span class="status-pill deleted">Archived</span>
          {% else %}
            <span class="status-pill active">Active</span>
          {% endif %}
        </p>
        <h1>{{ model.name }}</h1>
        <p class="hero-copy">
          Experiment:
          {% if experiment %}
            <strong>#{{ experiment.id }} · {{ experiment.name }}</strong>
            <span class="status-pill status-{{ experiment.status }}">{{ experiment.status }}</span>
          {% else %}
            <span class="muted">unknown</span>
          {% endif %}
        </p>
        {% if dataset %}
          <p class="hero-copy">
            Dataset chain:
            <strong>{{ dataset.name }}</strong>
            {% if dataset_version %} · data v{{ dataset_version.version_number }}{% endif %}
            {% if feature_set %} · {{ feature_set.name }}{% endif %}
          </p>
        {% endif %}
      </div>
      <div class="hero-actions">
        {% if experiment %}<a class="ghost-link" href="/ui/experiments/{{ experiment.id }}">Open experiment</a>{% endif %}
        {% if dataset %}<a class="ghost-link" href="/ui/datasets/{{ dataset.id }}">Open dataset</a>{% endif %}
        {% if model.deleted_at %}
          <form method="post" action="/ui/models/{{ model.id }}/restore">
            <button type="submit">Restore model</button>
          </form>
        {% else %}
          <form method="post" action="/ui/models/{{ model.id }}/delete"
                onsubmit="return confirm('Archive model {{ model.name }}?');">
            <button type="submit" class="danger">Archive model</button>
          </form>
        {% endif %}
      </div>
    </header>

    {% if message %}<div class="notice success">{{ message }}</div>{% endif %}
    {% if error %}<div class="notice error">{{ error }}</div>{% endif %}

    {% if not model.deleted_at %}
      {{ displays.archive_impact(archive_dependencies) }}
    {% endif %}

    {{ displays.lineage_dependencies(lineage_upstream, lineage_downstream) }}

    {% if not model.deleted_at %}
      <section class="panel wide collapsible-panel">
        <details class="edit-details">
          <summary>
            <span>
              <strong>Edit fields</strong>
              <small>Update model metadata, artifact and linked experiment</small>
            </span>
          </summary>
          <form method="post" action="/ui/models/{{ model.id }}/update" class="stacked-form edit-form">
            {{ forms.text_input('name', 'Name', 'titanic_rf_extended_model', model.name, True) }}
            <label>
              <span>Experiment</span>
              <select name="experiment_id" required>
                {% for candidate in experiments %}
                  <option value="{{ candidate.id }}" {% if model.experiment_id == candidate.id %}selected{% endif %}>
                    #{{ candidate.id }} · {{ candidate.name }} · {{ candidate.status }}
                  </option>
                {% endfor %}
              </select>
            </label>
            {{ forms.text_input('framework', 'Framework', 'scikit-learn', model.framework or '') }}
            {{ forms.text_input('version', 'Version', '1.0.0', model.version or '') }}
            {{ forms.text_input('artifact_path', 'Artifact path', 'artifacts/models/model.pkl', model.artifact_path or '') }}
            {{ forms.textarea('description', 'Description', model.description or '', placeholder='Short model description') }}
            <button type="submit">Save model</button>
          </form>
        </details>
      </section>
    {% endif %}

    <section class="panel">
      {{ displays.panel_header('Model', 'Metadata') }}
      <div class="metadata-grid">
        {{ displays.stat_card('Framework', model.framework or '—') }}
        {{ displays.stat_card('Version', model.version or '—') }}
        {{ displays.stat_card('Experiment', experiment and experiment.name or 'unknown') }}
      </div>
    </section>

    <section class="panel">
      {{ displays.panel_header('Artifact', 'Model artifact') }}
      {% if model.artifact_path %}
        <p class="hero-copy"><strong>{{ model.artifact_path }}</strong></p>
      {% else %}
        <p class="muted">No artifact path recorded</p>
      {% endif %}
      {% if model.description %}
        <p class="panel-copy">{{ model.description }}</p>
      {% endif %}
    </section>

    {% include "ui/_lineage_section.html.j2" %}
  </div>
{% endblock body %}
