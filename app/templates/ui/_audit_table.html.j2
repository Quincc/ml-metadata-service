<div id="audit-table-wrap" class="table-wrap">
  <table>
    <thead><tr><th>When</th><th>Action</th><th>Entity</th><th>ID</th><th>Name</th></tr></thead>
    <tbody>
      {% for log in audit_logs %}
        <tr>
          <td>{{ log.local_created_at.strftime('%Y-%m-%d %H:%M:%S') if log.local_created_at else '—' }}</td>
          <td><span class="status-pill status-{{ log.action }}">{{ log.action }}</span></td>
          <td>{{ log.entity_type }}</td>
          <td>#{{ log.entity_id }}</td>
          <td>{{ log.entity_name or '—' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="empty-row">No audit events match the filters</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
