# Скопируйте в .env (или .env.dev / .env.prod) и подправьте значения.
# Файл .env.{APP_ENV} имеет приоритет над .env, оба перекрываются переменными процесса.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/metadata_db
APP_ENV=dev

# Поведение запуска
LOG_LEVEL=INFO
SQL_ECHO=false

# Пул соединений (только для PostgreSQL/MySQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Ожидание БД на старте
DB_WAIT_MAX_ATTEMPTS=10
DB_WAIT_DELAY_SECONDS=2
